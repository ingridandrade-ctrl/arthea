{
  "installCommand": "npm ci && npx prisma generate",
  "buildCommand": "npm run vercel-build",
  "regions": ["gru1"],
  "functions": {
    "src/app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/flows",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/followups",
      "schedule": "*/10 * * * *"
    }
  ]
}
