# Database
DATABASE_URL="postgresql://user:password@localhost:5432/arthea"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Anthropic (Claude API)
ANTHROPIC_API_KEY="sk-ant-..."

# ─── WhatsApp Provider ──────────────────────────────────────────
# Choose: "official" (Meta Cloud API) or "evolution" (Evolution API)
WHATSAPP_PROVIDER="official"

# ─── WhatsApp Business Cloud API (Meta Official) ────────────────
# Get these at: https://developers.facebook.com/apps → WhatsApp
WHATSAPP_API_TOKEN="your-meta-access-token"
WHATSAPP_PHONE_ID="your-phone-number-id"
WHATSAPP_VERIFY_TOKEN="your-webhook-verify-token"

# ─── Evolution API (alternative, self-hosted) ───────────────────
# Only needed if WHATSAPP_PROVIDER="evolution"
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE="arthea"

# Cron Secret (para proteger endpoint de automacoes)
CRON_SECRET="your-cron-secret"

# ─── Modulo Financeiro ──────────────────────────────────────────
# Hash bcrypt da senha de acesso ao financeiro
# Gere com: node -e "require('bcryptjs').hash('suaSenha', 10).then(console.log)"
FINANCE_PASSWORD_HASH="$2b$10$..."

# ─── Meta Marketing API (Facebook/Instagram Ads) ────────────────
# Crie um app em https://developers.facebook.com/apps
# Produtos: "Facebook Login", "Marketing API" e "Webhooks"
# Permissoes minimas: ads_management, ads_read, business_management,
#   leads_retrieval, pages_show_list, pages_read_engagement
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
META_GRAPH_VERSION="v21.0"
# URL publica do Arthea (sem barra final). Usada como base do redirect_uri.
META_REDIRECT_BASE_URL="http://localhost:3000"
# Token de verificacao para o webhook do Lead Ads (qualquer string secreta)
META_WEBHOOK_VERIFY_TOKEN="your-meta-webhook-verify-token"

# ─── Mindfulness (projeto Iasmim) ───────────────────────────────
# Senha de acesso ao painel de analise em /mindfulness/painel.
# O fluxo publico em /mindfulness e aberto, sem senha.
MINDFULNESS_ADMIN_PASSWORD="iasmim-mindfulness-2026"

# ─── Clínica Brescancin (formulário pré-consulta) ────────────────
# Senha do painel /admin em consulta.clinicabrescancin.com.br.
# Cookie é assinado com HMAC-SHA256 usando NEXTAUTH_SECRET.
BRESCANCIN_ADMIN_PASSWORD=
